# 复制为 .env 后填写。不要提交 .env，也不要把 Token 放进代码或 URL。
RAG_API_BASE_URL=http://10.1.0.220:9002/api
RAG_API_TOKEN=
RAG_DATABASE_NAME=common_dataset
# 必须与建库时使用的度量方式一致；公开库 common_dataset 固定为 cosine。
RAG_METRIC_TYPE=cosine
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.0
RAG_CONTEXT_MAX_FILES=5
RAG_CONTEXT_MAX_CHARS=6000
RAG_TIMEOUT_SECONDS=45
RAG_TEMPERATURE=0.2
RAG_MAX_TOKENS=300
